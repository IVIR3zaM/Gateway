# Local Claude settings stay untracked; the vendored Planzilla skills and agents are tracked.
.claude/*
!.claude/skills/
!.claude/agents/
.claude/skills/*
!.claude/skills/plz-*/
.claude/agents/*
!.claude/agents/plz-*.md
.vscode/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
hetzner/terraform/backend.hcl
# Only the Hetzner stack tracks its provider lock file (CI runs it).
aws/terraform/.terraform.lock.hcl

# Generated v2ray artifacts (live under aws/ and hetzner/ after apply)
**/client-config.json
**/v2ray-share.txt
**/origin-cert.pem
**/origin-key.pem

.DS_Store
